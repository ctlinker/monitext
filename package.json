{
	"homepage": "https://ctlinker.github.io/monitext/",
	"name": "@monitext/monorepo",
	"version": "0.0.0",
	"description": "Monitext aim to be an all in one monitoring solution for js/ts based applications.",
	"private": true,
	"scripts": {
		"changeset": "pnpm exec changeset",
		"syncpack": "pnpm exec syncpack",
		"format": "pnpm exec prettier",
		"tool": "./tools/cmd/main.sh",
		"prepare": "husky",
		"docs:dev": "node docs/scripts/sync-latest.js && vitepress dev docs",
		"docs:build": "node docs/scripts/sync-latest.js && vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"docs:publish": "pnpm run docs:build && pnpm exec gh-pages -d docs/.vitepress/dist"
	},
	"keywords": [
		"monitext",
		"observability",
		"logging",
		"event-driven",
		"event system",
		"monitoring",
		"error tracking",
		"telemetry",
		"instrumentation",
		"plugin system",
		"debugging",
		"typescript",
		"nodejs"
	],
	"repository": {
		"url": "https://github.com/ctlinker/monitext.git",
		"directory": "/",
		"type": "git"
	},
	"author": {
		"name": "Chatelin",
		"email": "linkeris404@gmail.com",
		"url": "https://github.com/ctlinker"
	},
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.28.1",
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@types/bun": "^1.3.12",
		"@types/deno": "^2.5.0",
		"@types/node": "^25.6.0",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitepress": "2.0.0-alpha.17",
		"vitest": "^4.1.4"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	}
}
